# 憑證、密碼與權杖 — 絕不進版控
.env
.env.*
!.env.example
credentials/
token.json
client_secret*.json
*credentials*.json
# 註：不要用 *.json 一網打盡——那會連 vercel.json 這類設定檔一起擋掉，
#     曾因此讓部署缺少設定而整站 404。要擋就指名擋。

# 產出與輸入資料（含個資、奉獻金額）
_inputs/
outputs/
*.docx
*.xlsx
*.pdf
!範本/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# macOS
.DS_Store

# git bundle（開發歷史的搬運工具，不需進版控）
*.bundle
