# 憑證、密碼與權杖 — 絕不進版控
.env
.env.*
!.env.example
credentials/
token.json
client_secret*.json
*credentials*.json
# 註：不要用 *.json 一網打盡——那會連 vercel.json 這類設定檔一起擋掉，
#     曾因此讓部署缺少設定而整站 404。要擋就指名擋。

# 產出與輸入資料（含個資、奉獻金額）
_inputs/
outputs/
*.docx
*.xlsx
*.pdf
!範本/**
# 例外：雲端唯一的範本來源與年度贈經計畫，必須跟程式一起部署
# ⚠️ templates/ 含會員個資與具名健康資訊 → repo 必須維持 private
!templates/**
!贈經計畫/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# macOS
.DS_Store

# git bundle（開發歷史的搬運工具，不需進版控）
*.bundle

# 沙箱刪不掉的殘留檔（git 鎖檔、暫存物件）暫放處，可整個刪掉
_to_delete/
