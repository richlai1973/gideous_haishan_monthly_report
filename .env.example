# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除，不會進版控。
#
#   cp .env.example .env
#
# 雲端部署時不要用 .env，改在平台的環境變數設定
# （Vercel：Project → Settings → Environment Variables）

# ── 存取密碼 ────────────────────────────────────────────
# 未設定時，本機不啟用驗證；雲端環境則一律擋下（回 503）。
APP_PASSWORD=

# 簽章金鑰。留空會由密碼衍生；設定後即使更換密碼也不會登出所有人。
# 產生方式：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# ── 路徑 ────────────────────────────────────────────────
# GIDEONS_BASE_DIR=/Users/你的帳號/Documents/海山支會
# GIDEONS_CRED_DIR=./credentials
# GIDEONS_DRIVE_PARENT=15HBrIm4TOJrIMHo6ydHR2bWHN0ZTrWJ5
